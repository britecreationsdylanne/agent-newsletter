# BriteCo Brief - Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for content generation AND image generation)
OPENAI_API_KEY=sk-...

# Perplexity API Key (required for research)
PERPLEXITY_API_KEY=pplx-...

# Anthropic API Key (optional, for Claude-based content)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API Key (optional, only used for Gemini web-search grounding)
# Get this from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIza...

# Default Image Model (optional, defaults to gpt-image-2)
DEFAULT_IMAGE_MODEL=gpt-image-2

# Default Image Quality (optional: low | medium | high | auto; defaults to medium)
DEFAULT_IMAGE_QUALITY=medium

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
